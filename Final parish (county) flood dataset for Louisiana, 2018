def figures(d, ann, shapes, lat):
    a = ann.set_index("parish_fips")
    fig, axes = plt.subplots(2, 2, figsize=(14, 11))
    panels = [
        ("frequency_events", "A. Frequency: flood events in 2018", "Events", "Blues"),
        ("magnitude_mean_peak_ratio", "B. Magnitude: mean event peak / 2-yr flow", "Ratio", "Oranges"),
        ("duration_median_rise_h", "C. Duration: median rise time", "Hours", "Greens"),
        ("severity_mean_norm", "D. Severity: mean (peak ratio / rise time)", "per hour", "Reds"),
    ]
    for ax, (col, title, lab, cmap) in zip(axes.ravel(), panels):
        v = a[col] if col in a else pd.Series(dtype=float)
        vals = v.dropna()
        vmin, vmax = (vals.min(), vals.quantile(0.95)) if len(vals) else (0, 1)
        draw_parishes(ax, shapes, v.to_dict(), cmap, vmin, max(vmax, vmin + 1e-6), lab, fig)
        low = a.index[a.confidence.isin(["low", "unverified"])]
        for f in low:
            for ring in shapes.get(f, []):
                ax.add_patch(Polygon(ring, closed=True, fc="none", ec="k", lw=0.6, hatch="///"))
        ax.set_title(title)
    axes[1, 1].legend(handles=[Patch(fc="white", ec="k", hatch="///",
                                     label="low / unverified confidence")],
                      loc="lower left", fontsize=8)
    fig.suptitle(f"Louisiana parish flood characteristics, {YEAR}", fontweight="bold")
    fig.tight_layout()
    fig.savefig(FIG_DIR / "fig9_parish_maps_2018.png", dpi=160)
    plt.close(fig)

    # calendar: parishes (north -> south) x days
    order = sorted(ALL_PARISHES, key=lambda f: -lat.get(f, 0))
    mat = (d.assign(v=np.select([d.source == "NWM", d.source == "USGS"],
                                [d.nwm_frac_flooding, np.minimum(d.usgs_gauges_flooding, 1)],
                                np.nan))
           .pivot(index="parish_fips", columns="date", values="v").reindex(order))
    fl = d.assign(f=d.flood_day.fillna(False).astype(bool)).pivot(
        index="parish_fips", columns="date", values="f").reindex(order)
    fig, ax = plt.subplots(figsize=(16, 12))
    cmap_b = plt.get_cmap("Blues").copy()
    cmap_b.set_bad("#bbbbbb")
    im = ax.imshow(np.ma.masked_invalid(np.sqrt(mat.to_numpy(float))), aspect="auto",
                   cmap=cmap_b, interpolation="nearest")
    flood = np.ma.masked_where(~fl.fillna(False).to_numpy(bool), np.ones(fl.shape))
    ax.imshow(flood, aspect="auto", cmap="autumn", alpha=0.55, interpolation="nearest")
    ax.scatter([], [], s=40, c="#ff0000", marker="s", alpha=0.55, label="parish flood day")
    names = d.drop_duplicates("parish_fips").set_index("parish_fips").parish_name
    ax.set_yticks(range(len(order)))
    ax.set_yticklabels([f"{names.get(f, f)} ({d.loc[d.parish_fips == f, 'confidence'].iloc[0][0].upper()})"
                        for f in order], fontsize=6)
    months = pd.date_range(f"{YEAR}-01-01", periods=12, freq="MS")
    ax.set_xticks([(m - months[0]).days for m in months])
    ax.set_xticklabels(months.strftime("%b"))
    cb = fig.colorbar(im, ax=ax, shrink=0.5)
    cb.set_label("share of parish reaches above 2-yr flow (sqrt scale)")
    ax.legend(loc="upper right", fontsize=8)
    ax.set_title(f"Daily flooding by parish, {YEAR} (north at top; H/M/L/U = confidence;"
                 " grey = no reliable data; USGS parishes = gauge flooding yes/no)",
                 fontweight="bold")
    fig.tight_layout()
    fig.savefig(FIG_DIR / "fig10_parish_calendar_2018.png", dpi=160)
    plt.close(fig)


