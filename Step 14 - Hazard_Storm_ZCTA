def set_paths(project_dir):
    global D, OUT
    D = project_dir / "data"
    OUT = D / "final_zcta"
    OUT.mkdir(parents=True, exist_ok=True)


def day(x):
    return pd.to_datetime(pd.Series(x).astype(str).str[:10], errors="coerce")


