# 1. ONE ROW PER STORM x ZCTA
# ----------------------------------------------------------------------------
def storm_zcta_rows(ev):
    ev = ev.copy()
    ev["s"], ev["e"], ev["p"] = day(ev.start_date), day(ev.end_date), day(ev.peak_day)
    rows = []
    for (sid, zc), g in ev.groupby(["storm_id", "zcta"], sort=False):
        top = g.loc[g.magnitude_best.fillna(-1).idxmax()]
        s, e = g.s.min(), g.e.max()
        rows.append({
            "storm_id": sid, "zcta": zc,
            "main_parish_fips": top.get("main_parish_fips"),
            "main_parish_name": top.get("main_parish_name"),
            "start_date": s.date(), "end_date": e.date(), "peak_date": top.p.date(),
            "length_days": (e - s).days + 1,
            "n_flood_events_combined": len(g),
            "magnitude_best": g.magnitude_best.max(),
            "magnitude_source": ("observed (USGS)" if (g.magnitude_source == "observed (USGS)").any()
                                 else top.magnitude_source),
            "magnitude_modeled": g.magnitude_modeled.max(),
            "magnitude_observed": g.magnitude_observed.max(),
            "return_period_p90": g.return_period_p90.max(),
            "return_period_max": g.return_period_max.max(),
            "onset_to_peak_h": g.duration_median_rise_h.median(),
            "severity_max_norm": g.severity_max_norm.max(),
            "max_frac_reaches": g.max_frac_reaches.max(),
            "max_reaches_flooding": g.max_reaches_flooding.max(),
            "observed_stage_above_flood_ft": g.observed_stage_above_flood_ft.max()
            if "observed_stage_above_flood_ft" in g else np.nan,
            "usgs_gauges": ";".join(sorted(set(";".join(g.usgs_gauges.fillna("")).split(";")) - {""}))
            if "usgs_gauges" in g else "",
            "confidence": top.confidence,
        })
    out = pd.DataFrame(rows)
    out["return_period_class"] = pd.cut(out.return_period_p90, RP_BINS, labels=RP_LABELS, right=False)
    return out


