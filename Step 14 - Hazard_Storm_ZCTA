def add_rain(t, rain_h, rain_d):
    if rain_h is None:
        return t
    from importlib import util  # noqa: F401  (keeps the import block simple)
    h = rain_h.copy()
    tl = pd.to_datetime(h.time_utc).dt.tz_localize("UTC") - pd.Timedelta(minutes=30)
    h["tloc"] = tl.dt.tz_convert(LOCAL_TZ).dt.tz_localize(None)
    h = h.sort_values(["zcta", "tloc"])
    h["roll24"] = h.groupby("zcta").rain_mean_mm.transform(lambda s: s.rolling(24, min_periods=1).sum())
    grp = {k: g for k, g in h.groupby("zcta")}
    a14 = None
    ap = D / "rain" / "atlas14_zcta.csv"
    if ap.exists():
        a14 = pd.read_csv(ap, dtype={"zcta": str})
    tot, m24, m1, m1c, rp24, rp1 = [], [], [], [], [], []
    for zc, s, e in zip(t.zcta, day(t.start_date), day(t.end_date)):
        g = grp.get(zc)
        if g is None:
            for L in (tot, m24, m1, m1c):
                L.append(np.nan)
            continue
        w = g[(g.tloc >= s - pd.Timedelta(days=RAIN_LEAD_DAYS)) & (g.tloc < e + pd.Timedelta(days=1))]
        tot.append(w.rain_mean_mm.sum())
        m24.append(w.roll24.max() if len(w) else np.nan)
        m1.append(w.rain_mean_mm.max() if len(w) else np.nan)
        m1c.append(w.rain_max_cell_mm.max() if len(w) else np.nan)
    t["rain_event_total_mm"] = np.round(tot, 1)
    t["rain_max_24h_mm"] = np.round(m24, 1)
    t["rain_max_1h_mm"] = np.round(m1, 2)
    t["rain_max_1h_cell_mm"] = np.round(m1c, 2)
    if a14 is not None and len(a14):
        tab = {}
        for (zc, dur), g in a14.groupby(["zcta", "duration"]):
            g = g.sort_values("ari_yr")
            if len(g) >= 2 and (g.depth_mm > 0).all():
                tab[(zc, dur)] = (np.log(g.ari_yr.to_numpy()), np.log(g.depth_mm.to_numpy()))

        def rp(zcs, vals, dur):
            out = []
            for zc, x in zip(zcs, vals):
                k = tab.get((zc, dur))
                if k is None or not np.isfinite(x):
                    out.append(np.nan)
                elif x <= 0:
                    out.append(1.0)
                else:
                    out.append(float(np.exp(np.interp(np.log(x), k[1], k[0], left=k[0][0], right=k[0][-1]))))
            return np.round(np.clip(out, 1, 1000), 2)
        t["rain_rp_24h"] = rp(t.zcta, t.rain_max_24h_mm, "24h")
        t["rain_rp_1h_cell"] = rp(t.zcta, t.rain_max_1h_cell_mm, "1h")
    return t


def add_coastal(t, cd):
    if cd is None or cd.empty:
        t["coastal_wl_max_m_mhhw"] = np.nan
        t["coastal_flood_class"] = pd.NA
        t["coastal_report"] = ""
        return t
    cd = cd.copy()
    cd["date"] = day(cd.date)
    grp = {k: g for k, g in cd.groupby("zcta")}
    wl, cls, rep = [], [], []
    for zc, s, e in zip(t.zcta, day(t.start_date), day(t.end_date)):
        g = grp.get(zc)
        if g is None:
            wl.append(np.nan); cls.append(pd.NA); rep.append("")
            continue
        w = g[(g.date >= s - pd.Timedelta(days=RAIN_LEAD_DAYS)) & (g.date <= e)]
        has_gauge = "wl_max_m_mhhw" in w and w.wl_max_m_mhhw.notna().any()
        wl.append(w.wl_max_m_mhhw.max() if has_gauge else np.nan)
        if has_gauge:
            cls.append(INV_FLOOD[int(w.coastal_flood_class.fillna("none").map(FLOOD_ORDER).max())])
        else:
            cls.append(pd.NA)
        rep.append(";".join(sorted(set(";".join(w.get("coastal_report", pd.Series(dtype=str))
                                                  .fillna("").astype(str)).split(";")) - {""})))
    t["coastal_wl_max_m_mhhw"] = np.round(pd.to_numeric(pd.Series(wl), errors="coerce"), 3)
    t["coastal_flood_class"] = cls
    t["coastal_report"] = rep
    return t


def add_hurricane(t, hur):
    cols = ["tc_name", "tc_nhc_id", "tc_dist_km", "tc_wind_kt", "tc_category", "tc_rain_mm"]
    if hur is None or hur.empty:
        for c in cols:
            t[c] = np.nan
        return t
    hur = hur.copy()
    hur["cd"] = day(hur.closest_date_local)
    grp = {k: g for k, g in hur.groupby("zcta")}
    rows = []
    for zc, s, e in zip(t.zcta, day(t.start_date), day(t.end_date)):
        g = grp.get(zc)
        m = g[(g.cd >= s + pd.Timedelta(days=TC_WINDOW[0])) & (g.cd <= e + pd.Timedelta(days=TC_WINDOW[1]))] \
            if g is not None else None
        if m is None or m.empty:
            rows.append([np.nan] * len(cols))
            continue
        r = m.sort_values("dist_km").iloc[0]
        rows.append([r.storm_name, r.nhc_id, r.dist_km, r.storm_wind_kt, r.storm_category,
                     r.get("storm_rain_mm", np.nan)])
    t[cols] = pd.DataFrame(rows, columns=cols, index=t.index)
    return t


def composite(t):
    parts = []
    for c in ("return_period_p90", "max_frac_reaches", "length_days", "rain_max_24h_mm"):
        if c in t and t[c].notna().any():
            parts.append(t[c].rank(pct=True))
    return pd.concat(parts, axis=1).mean(axis=1).round(3) if parts else np.nan


