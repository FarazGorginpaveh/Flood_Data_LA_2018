def dictionary(tables):
    rows = []
    for tname, df in tables.items():
        for c in df.columns:
            desc, unit, typ, miss = DICT.get(c, ("(see README column guide)", "-", str(df[c].dtype), BLANK))
            rows.append({"table": tname, "variable": c, "description": desc, "unit": unit,
                         "type_or_format": typ, "missingness": miss,
                         "pct_missing": round(100 * df[c].isna().mean(), 1)})
    return pd.DataFrame(rows)


CONVENTIONS = """# Conventions - Louisiana {year} flood / hazard exposure dataset

**Spatial unit:** ZIP Code Tabulation Area (ZCTA), **2020 U.S. Census boundaries**
(cb_2020_us_zcta520_500k). ZCTAs are linked to the parish (county) holding most of
their land. A parish-level version is in data/final.

**Temporal unit:** local calendar day, **America/Chicago** (raw times in UTC).

**Main table** (hazard_events_zcta_LA_{year}.csv): one row per **storm x ZCTA** for any
hazard; key = (storm_id, zcta), unique. `flood_events_zcta_LA_{year}.csv` holds the
streamflow-only rows.

**Zero / absent / missing convention**
- A ZCTA **absent** from the main table for a storm had **no hazard** in that storm,
  subject to what can be measured there (see zcta_universe_LA_{year}.csv):
  - stream flooding: measured if `streamflow_status` = "ZCTA reaches" or
    "imputed from parish"; **missing** if "missing (unverified parish)";
  - rainfall and tropical cyclones: measured for **every** ZCTA;
  - coastal flooding: measured only where `has_tide_gauge` = 1.
- In the daily table, 0 = hazard measured and absent; **blank = not measured / missing**.
- In all CSV files a **blank cell = missing / not applicable**; the reason is given in
  the `missingness` column of the data dictionary. No numeric codes such as -999.

**Sources of the magnitude:** `magnitude_source` = observed (USGS) / modeled (NWM) /
imputed (parish) / none (hazard without stream flooding).

**Limitations:** stream flooding is riverine (NOAA National Water Model v3.0
retrospective); urban drainage flooding is under-represented (use the rainfall
variables); coastal flooding only near tide gauges; `max_frac_reaches` is an extent
proxy, not flooded area; flood depth is not included.
"""


# ----------------------------------------------------------------------------
# 4. IMPUTATION AND HAZARD DAYS
# ----------------------------------------------------------------------------
def parish_imputation(u):
    """Main-parish flood days for ZCTAs without usable reaches."""
    pdaily = pd.read_csv(D / "final" / "parish_daily_2018.csv",
                         dtype={"parish_fips": str, "flood_day": "boolean"})
    pdaily["date"] = day(pdaily.date)
    pdaily = pdaily[pdaily.source != "none"]
    need = u[u.data_status != "included"][["zcta", "main_parish_fips"]]
    x = need.merge(pdaily[["parish_fips", "date", "flood_day", "magnitude_peak_ratio",
                           "duration_rise_h", "severity_norm", "nwm_frac_flooding"]],
                   left_on="main_parish_fips", right_on="parish_fips", how="inner")
    return x.drop(columns=["parish_fips"])


def hazard_runs(hd, covered):
    """Runs of hazard days per ZCTA, excluding days inside streamflow windows."""
    hd = hd[~pd.Series(list(zip(hd.zcta, hd.date)), index=hd.index).isin(covered)]
    runs = []
    for zc, g in hd.sort_values("date").groupby("zcta"):
        start = prev = None
        acc = []
        for _, r in g.iterrows():
            if start is not None and (r.date - prev).days <= GAP_DAYS + 1:
                prev = r.date
                acc.append(r)
                continue
            if start is not None:
                runs.append((zc, start, prev, acc))
            start = prev = r.date
            acc = [r]
        if start is not None:
            runs.append((zc, start, prev, acc))
    rows = []
    for zc, s, e, acc in runs:
        a = pd.DataFrame(acc)
        rows.append({"zcta": zc, "start": s, "end": e,
                     "hazard_flood_imputed": int(a.imp.any()), "hazard_heavy_rain": int(a.rain.any()),
                     "hazard_coastal": int(a.coast.any()), "hazard_tc": int(a.tc.any()),
                     "tc_names": ";".join(sorted(set(";".join(a.tc_name.fillna("")).split(";")) - {""}))})
    return pd.DataFrame(rows)


def group_runs(runs, cent, storms_geo):
    """Group hazard runs into storms; attach to overlapping streamflow storms."""
    n = len(runs)
    parent = list(range(n))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    lat = runs.zcta.map(cent.y).to_numpy()
    lon = runs.zcta.map(cent.x).to_numpy()
    tol = pd.Timedelta(days=1)
    s, e = runs.start.to_numpy(), runs.end.to_numpy()
    for i in range(n):
        ov = (runs.start <= runs.end.iloc[i] + tol) & (runs.end >= runs.start.iloc[i] - tol)
        idx = np.flatnonzero(ov.to_numpy())
        idx = idx[idx > i]
        if not len(idx):
            continue
        dkm = haversine(lat[i], lon[i], lat[idx], lon[idx])
        same_tc = np.array([bool(runs.tc_names.iloc[i]) and runs.tc_names.iloc[i] == runs.tc_names.iloc[j]
                            for j in idx])
        for j in idx[(dkm <= MERGE_KM) | same_tc]:
            ri, rj = find(i), find(j)
            if ri != rj:
                parent[rj] = ri
    groups = {}
    for i in range(n):
        groups.setdefault(find(i), []).append(i)

    sid = np.empty(n, dtype=object)
    new_k = 0
    for members in sorted(groups.values(), key=lambda m: runs.start.iloc[m].min()):
        gs, ge = runs.start.iloc[members].min(), runs.end.iloc[members].max()
        glat, glon = lat[members], lon[members]
        best, best_ov = None, 0
        for st_id, (ss, se, slat, slon) in storms_geo.items():
            ovd = (min(ge, se + tol) - max(gs, ss - tol)).days
            if ovd < 0:
                continue
            dmin = np.nanmin(haversine(glat[:, None], glon[:, None], slat[None, :], slon[None, :]))
            if dmin <= MERGE_KM and ovd + 1 > best_ov:
                best, best_ov = st_id, ovd + 1
        if best is None:
            new_k += 1
            best = f"LA{YEAR}_H{new_k:03d}"
        for i in members:
            sid[i] = best
    return sid


def haversine(lat1, lon1, lat2, lon2):
    lat1, lon1, lat2, lon2 = map(np.radians, (lat1, lon1, lat2, lon2))
    a = (np.sin((lat2 - lat1) / 2) ** 2
         + np.cos(lat1) * np.cos(lat2) * np.sin((lon2 - lon1) / 2) ** 2)
    return 6371 * 2 * np.arcsin(np.sqrt(a))


# ----------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project-dir", default=str(PROJECT_DIR))
    args = ap.parse_args()
    set_paths(Path(args.project_dir))
    Z = D / "zcta"

    ev = pd.read_csv(Z / "zcta_events_2018_enriched.csv", dtype={"zcta": str, "main_parish_fips": str})
    ann = pd.read_csv(Z / "zcta_annual_2018.csv", dtype={"zcta": str, "main_parish_fips": str})
    storms = pd.read_csv(Z / "storms_2018.csv", dtype={"zctas": str, "parishes": str})
    zb = gpd.read_file(Z / "zcta_boundaries_LA.gpkg")
    zb["zcta"] = zb.zcta.astype(str)
    cent = zb.set_index("zcta").geometry.to_crs(3857).centroid.to_crs(4326)

    rh_p, rd_p = D / "rain" / f"zcta_rain_hourly_{YEAR}.parquet", D / "rain" / f"zcta_rain_daily_{YEAR}.csv"
    cd_p, hu_p = D / "coastal" / f"zcta_coastal_daily_{YEAR}.csv", D / "coastal" / f"hurricane_zcta_{YEAR}.csv"
    rain_h = pd.read_parquet(rh_p) if rh_p.exists() else None
    rain_d = pd.read_csv(rd_p, dtype={"zcta": str}) if rd_p.exists() else None
    coast = pd.read_csv(cd_p, dtype={"zcta": str, "station_id": str}) if cd_p.exists() else None
    hur = pd.read_csv(hu_p, dtype={"zcta": str}) if hu_p.exists() else None
    for name, obj in (("rainfall (step 12)", rain_h), ("coastal (step 13)", coast),
                      ("hurricanes (step 13)", hur)):
        if obj is None:
            print(f"  ! {name} not found - those hazards and columns will be blank")
    if rain_h is not None:
        rain_h["zcta"] = rain_h.zcta.astype(str)

    # ---- universe ------------------------------------------------------------------
    u = ann[["zcta", "main_parish_fips", "main_parish_name", "n_reaches", "urban", "confidence"]].copy()
    reason = ann.get("no_data_reason", pd.Series("", index=ann.index)).fillna("")
    u["data_status"] = np.where(ann.confidence == "no data",
                                np.where(reason.str.contains("unverified"), "no data: unverified parish",
                                         "no data: fewer than 5 reaches"), "included")

    # ---- B. parish imputation -----------------------------------------------------------
    imp = parish_imputation(u)
    imp_z = set(imp.zcta)
    u["streamflow_status"] = np.select(
        [u.data_status == "included", u.zcta.isin(imp_z)],
        ["ZCTA reaches", "imputed from parish"], "missing (unverified parish)")

    # ---- daily exposure ----------------------------------------------------------------
    zd = pd.read_csv(Z / "zcta_daily_2018.csv", dtype={"zcta": str, "flood_day": "boolean"})
    daily = zd[["zcta", "date", "flood_day", "magnitude_peak_ratio", "reaches_flooding",
                "frac_flooding"]].rename(columns={"magnitude_peak_ratio": "flood_magnitude"})
    daily["date"] = day(daily.date)
    daily = daily.merge(u[["zcta", "data_status", "streamflow_status"]], on="zcta", how="left")
    nd = daily.data_status != "included"
    daily["flood_day"] = daily.flood_day.astype("Int64")
    daily.loc[nd, ["flood_day", "reaches_flooding", "frac_flooding"]] = pd.NA
    daily["flood_magnitude"] = daily.flood_magnitude.where(daily.flood_day.fillna(0) == 1, 0.0)
    daily.loc[nd, "flood_magnitude"] = np.nan
    im = imp.rename(columns={"flood_day": "imp_day", "magnitude_peak_ratio": "imp_mag"})
    daily = daily.merge(im[["zcta", "date", "imp_day", "imp_mag"]], on=["zcta", "date"], how="left")
    imp_day = daily.imp_day.fillna(False).astype(bool).astype(int)
    daily["flood_day_filled"] = daily.flood_day
    isimp = daily.streamflow_status == "imputed from parish"
    daily.loc[isimp, "flood_day_filled"] = imp_day[isimp]
    daily["flood_source"] = daily.streamflow_status.map({"ZCTA reaches": "ZCTA reaches",
                                                         "imputed from parish": "imputed (parish)"}).fillna("missing")
    daily["flood_magnitude_filled"] = daily.flood_magnitude
    daily.loc[isimp, "flood_magnitude_filled"] = np.where(imp_day[isimp] == 1, daily.imp_mag[isimp], 0.0)
    daily = daily.drop(columns=["imp_day", "imp_mag"])
    if rain_d is not None:
        r = rain_d.rename(columns={"rain_max_1h_cell_mm": "rain_max_1h_cell_mm_day"})
        r["date"] = day(r.date)
        daily = daily.merge(r[["zcta", "date", "rain_total_mm", "rain_max_1h_cell_mm_day",
                               "heavy_rain_day"]], on=["zcta", "date"], how="left")
        daily["heavy_rain_day"] = daily.heavy_rain_day.map(
            {True: 1, False: 0, "True": 1, "False": 0}).astype("Int64")
    else:
        daily["heavy_rain_day"] = pd.array([pd.NA] * len(daily), dtype="Int64")
    gauge_z = set()
    if coast is not None and len(coast) and "coastal_flood_class" in coast:
        c = coast[["zcta", "date", "coastal_flood_class"]].dropna(subset=["coastal_flood_class"])
        gauge_z = set(c.zcta)
        c = c.rename(columns={"coastal_flood_class": "coastal_flood_class_day"})
        c["date"] = day(c.date)
        daily = daily.merge(c.drop_duplicates(["zcta", "date"]), on=["zcta", "date"], how="left")
        cls = daily.coastal_flood_class_day
        daily["coastal_hazard_day"] = pd.array(
            np.where(cls.isna(), pd.NA, cls.isin(["minor", "moderate", "major"]).astype(int)), dtype="Int64")
    else:
        daily["coastal_flood_class_day"] = pd.NA
        daily["coastal_hazard_day"] = pd.array([pd.NA] * len(daily), dtype="Int64")
    daily["tc_within_250km"] = 0
    daily["tc_event_day"] = 0
    daily["tc_name_day"] = ""
    if hur is not None and len(hur):
        hur["cd"] = day(hur.closest_date_local)
        tc250 = set(zip(hur.zcta[hur.dist_km <= 250], hur.cd[hur.dist_km <= 250]))
        daily["tc_within_250km"] = [int((z_, d_) in tc250) for z_, d_ in zip(daily.zcta, daily.date)]
        near = hur[hur.dist_km <= TC_EVENT_KM]
        tcd = {}
        for zc, cdt, nm in zip(near.zcta, near.cd, near.storm_name):
            for k in range(-TC_EVENT_DAYS, TC_EVENT_DAYS + 1):
                tcd.setdefault((zc, cdt + pd.Timedelta(days=k)), set()).add(nm)
        key = list(zip(daily.zcta, daily.date))
        daily["tc_event_day"] = [int(k in tcd) for k in key]
        daily["tc_name_day"] = [";".join(sorted(tcd.get(k, ()))) for k in key]
    daily["any_hazard_day"] = ((daily.flood_day_filled.fillna(0) == 1) | (daily.heavy_rain_day.fillna(0) == 1)
                               | (daily.coastal_hazard_day.fillna(0) == 1) | (daily.tc_event_day == 1)).astype(int)

    # ---- streamflow storm-ZCTA rows (as before) -----------------------------------------------
    t = storm_zcta_rows(ev)
    t["storm_origin"] = "streamflow storm"
    t["hazard_streamflow"] = 1
    t["hazard_flood_imputed"] = 0
    covered = set()
    for zc, s, e in zip(t.zcta, day(t.start_date), day(t.end_date)):
        for dd in pd.date_range(s, e):
            covered.add((zc, dd))

    # ---- A. hazard-only runs ---------------------------------------------------------------------
    hd = daily.assign(imp=(daily.flood_source == "imputed (parish)") & (daily.flood_day_filled.fillna(0) == 1),
                      rain=daily.heavy_rain_day.fillna(0) == 1,
                      coast=daily.coastal_hazard_day.fillna(0) == 1,
                      tc=daily.tc_event_day == 1, tc_name=daily.tc_name_day)
    hd = hd[hd.imp | hd.rain | hd.coast | hd.tc]
    runs = hazard_runs(hd, covered)
    geo = {}
    for sid_, g in t.groupby("storm_id"):
        geo[sid_] = (day(g.start_date).min(), day(g.end_date).max(),
                     g.zcta.map(cent.y).to_numpy(), g.zcta.map(cent.x).to_numpy())
    if len(runs):
        runs["storm_id"] = group_runs(runs, cent, geo)
        new = []
        for (sid_, zc), g in runs.groupby(["storm_id", "zcta"]):
            new.append({"storm_id": sid_, "zcta": zc, "start_date": g.start.min().date(),
                        "end_date": g.end.max().date(), "peak_date": g.start.min().date(),
                        "length_days": (g.end.max() - g.start.min()).days + 1,
                        "n_flood_events_combined": 0, "hazard_streamflow": 0,
                        "hazard_flood_imputed": int(g.hazard_flood_imputed.max()),
                        "storm_origin": "streamflow storm" if not str(sid_).split("_")[-1].startswith("H")
                        else "hazard-only storm"})
        new = pd.DataFrame(new)
        # a ZCTA that already has a streamflow row in the same storm: merge the windows
        both = new.merge(t[["storm_id", "zcta"]], on=["storm_id", "zcta"], how="inner")
        for _, r in both.iterrows():
            m = (t.storm_id == r.storm_id) & (t.zcta == r.zcta)
            t.loc[m, "start_date"] = min(day(t.loc[m, "start_date"]).iloc[0], pd.Timestamp(r.start_date)).date()
            t.loc[m, "end_date"] = max(day(t.loc[m, "end_date"]).iloc[0], pd.Timestamp(r.end_date)).date()
            t.loc[m, "length_days"] = (pd.Timestamp(t.loc[m, "end_date"].iloc[0]) -
                                       pd.Timestamp(t.loc[m, "start_date"].iloc[0])).days + 1
        new = new.merge(t[["storm_id", "zcta"]], on=["storm_id", "zcta"], how="left", indicator=True)
        new = new[new._merge == "left_only"].drop(columns="_merge")
        new = new.merge(u[["zcta", "main_parish_fips", "main_parish_name", "confidence"]], on="zcta", how="left")
        # imputed flood magnitude from the parish
        if len(new) and new.hazard_flood_imputed.any():
            ii = imp.set_index(["zcta", "date"])
            mags, rises, sevs, fracs = [], [], [], []
            for zc, s, e, h in zip(new.zcta, day(new.start_date), day(new.end_date), new.hazard_flood_imputed):
                if not h:
                    mags.append(np.nan); rises.append(np.nan); sevs.append(np.nan); fracs.append(np.nan)
                    continue
                w = imp[(imp.zcta == zc) & (imp.date >= s) & (imp.date <= e) & imp.flood_day.fillna(False)]
                mags.append(w.magnitude_peak_ratio.max()); rises.append(w.duration_rise_h.median())
                sevs.append(w.severity_norm.max()); fracs.append(w.nwm_frac_flooding.max())
            new["magnitude_best"], new["onset_to_peak_h"] = mags, rises
            new["severity_max_norm"], new["max_frac_reaches"] = sevs, fracs
        new["magnitude_source"] = np.where(new.get("hazard_flood_imputed", 0) == 1, "imputed (parish)", "none")
        new.loc[new.hazard_flood_imputed == 1, "confidence"] = "low (imputed)"
        t = pd.concat([t, new], ignore_index=True)

    # hazard flags over each row's window (for all rows)
    hmap = hd.set_index(["zcta", "date"])
    fl = {"hazard_heavy_rain": "rain", "hazard_coastal": "coast", "hazard_tc": "tc"}
    for col in fl:
        t[col] = 0
    keys = set(hmap.index)
    for i, (zc, s, e) in enumerate(zip(t.zcta, day(t.start_date), day(t.end_date))):
        days = [(zc, d) for d in pd.date_range(s - pd.Timedelta(days=RAIN_LEAD_DAYS), e) if (zc, d) in keys]
        if days:
            sub = hmap.loc[days]
            for col, src_ in fl.items():
                t.iat[i, t.columns.get_loc(col)] = int(sub[src_].any())
    t["hazards"] = [";".join(n for n, v in (("streamflow", a), ("flood_imputed", b), ("heavy_rain", c),
                                              ("coastal", d_), ("tc", e_)) if v)
                    for a, b, c, d_, e_ in zip(t.hazard_streamflow, t.hazard_flood_imputed,
                                               t.hazard_heavy_rain, t.hazard_coastal, t.hazard_tc)]
    t = t.merge(ann[["zcta", "n_reaches"]], on="zcta", how="left", suffixes=("", "_a"))
    t = add_rain(t, rain_h, rain_d)
    t = add_coastal(t, coast)
    t = add_hurricane(t, hur)

    # ---- storm-level columns (recomputed over all hazard rows) --------------------------------------
    st_old = storms.set_index("storm_id")
    pname = u.set_index("main_parish_fips").main_parish_name.to_dict()
    srows = []
    for sid_, g in t.groupby("storm_id"):
        pars = sorted(set(g.main_parish_fips.dropna()))
        if sid_ in st_old.index:
            etype, basis = st_old.loc[sid_, "event_type"], st_old.loc[sid_, "event_type_basis"]
        elif g.hazard_tc.any():
            etype, basis = "tropical cyclone", "HURDAT2 track (no stream flooding)"
        elif g.hazard_coastal.any() and not g.hazard_heavy_rain.any():
            etype, basis = "coastal flooding", "tide gauges (no stream flooding)"
        elif g.hazard_heavy_rain.any():
            etype, basis = "heavy rainfall - no stream flooding", "AORC rainfall"
        else:
            etype, basis = "flooding - imputed from parish", "parish streamflow (imputed)"
        srows.append({"storm_id": sid_, "event_type": etype, "event_type_basis": basis,
                      "storm_start_date": day(g.start_date).min().date(),
                      "storm_end_date": day(g.end_date).max().date(),
                      "storm_peak_day": (st_old.loc[sid_, "peak_day"] if sid_ in st_old.index
                                         else day(g.start_date).mode().min().date()),
                      "storm_n_zctas": g.zcta.nunique(), "storm_zctas": ";".join(sorted(g.zcta)),
                      "storm_n_parishes": len(pars), "storm_parishes": ";".join(pars),
                      "storm_parish_names": ";".join(str(pname.get(p, p)) for p in pars)})
    sc = pd.DataFrame(srows)
    t = t.drop(columns=[c for c in sc.columns if c in t.columns and c != "storm_id"]).merge(sc, on="storm_id")
    t["severity_composite"] = composite(t)
    assert not t.duplicated(["storm_id", "zcta"]).any(), "storm_id x zcta is not unique"

    rnd = {"magnitude_best": 3, "magnitude_modeled": 3, "magnitude_observed": 3,
           "return_period_p90": 1, "return_period_max": 1, "onset_to_peak_h": 1,
           "severity_max_norm": 3, "max_frac_reaches": 3, "tc_dist_km": 1}
    for c, n in rnd.items():
        if c in t:
            t[c] = pd.to_numeric(t[c], errors="coerce").round(n)
    order = ["storm_id", "zcta", "main_parish_fips", "main_parish_name", "storm_origin", "hazards",
             "hazard_streamflow", "hazard_flood_imputed", "hazard_heavy_rain", "hazard_coastal", "hazard_tc",
             "start_date", "end_date", "peak_date", "length_days", "event_type", "event_type_basis",
             "magnitude_best", "magnitude_source", "return_period_p90", "return_period_class",
             "max_frac_reaches", "onset_to_peak_h", "severity_max_norm", "severity_composite",
             "rain_event_total_mm", "rain_max_24h_mm", "rain_rp_24h", "rain_max_1h_cell_mm",
             "rain_rp_1h_cell", "coastal_flood_class", "coastal_wl_max_m_mhhw", "coastal_report",
             "tc_name", "tc_dist_km", "tc_wind_kt", "tc_category", "tc_rain_mm", "confidence", "n_reaches"]
    t = t[[c for c in order if c in t] + [c for c in t.columns if c not in order]]
    t = t.sort_values(["storm_start_date", "storm_id", "zcta"])
    t.to_csv(OUT / f"hazard_events_zcta_{STATE}_{YEAR}.csv", index=False)
    fsub = t[t.hazard_streamflow == 1]
    fsub.to_csv(OUT / f"flood_events_zcta_{STATE}_{YEAR}.csv", index=False)

    # ---- windows -> daily, universe ----------------------------------------------------------------
    win = []
    for sid_, zc, s, e in zip(t.storm_id, t.zcta, day(t.start_date), day(t.end_date)):
        for dd in pd.date_range(s, e):
            win.append((zc, dd, sid_))
    w = pd.DataFrame(win, columns=["zcta", "date", "in_storm_id"]).drop_duplicates(["zcta", "date"])
    daily = daily.merge(w, on=["zcta", "date"], how="left")
    daily["date"] = daily.date.dt.date
    daily = daily.drop(columns=["tc_name_day"])
    daily.to_csv(OUT / f"zcta_daily_exposure_{STATE}_{YEAR}.csv", index=False)

    u["has_tide_gauge"] = u.zcta.isin(gauge_z).astype(int)
    u["n_hazard_rows"] = u.zcta.map(t.groupby("zcta").size()).fillna(0).astype(int)
    u["n_storm_zcta_rows"] = u.zcta.map(fsub.groupby("zcta").size()).fillna(0).astype(int)
    u.to_csv(OUT / f"zcta_universe_{STATE}_{YEAR}.csv", index=False)

    dd_ = dictionary({f"hazard_events_zcta_{STATE}_{YEAR}": t,
                      f"zcta_daily_exposure_{STATE}_{YEAR}": daily,
                      f"zcta_universe_{STATE}_{YEAR}": u})
    dd_.to_csv(OUT / f"data_dictionary_{STATE}_{YEAR}.csv", index=False)
    (OUT / "CONVENTIONS.md").write_text(CONVENTIONS.format(year=YEAR), encoding="utf-8")

    # ---- summary ------------------------------------------------------------------------------------
    print(f"\nFINAL ZCTA DATASET, {STATE} {YEAR}")
    print(f"  ALL-HAZARD table: {len(t):,} storm-ZCTA rows, {t.storm_id.nunique()} storms, "
          f"{t.zcta.nunique()} ZCTAs (key storm_id x zcta unique)")
    print(f"    streamflow storms: {t[t.storm_origin == 'streamflow storm'].storm_id.nunique()}, "
          f"hazard-only storms: {t[t.storm_origin == 'hazard-only storm'].storm_id.nunique()}")
    for col in ("hazard_streamflow", "hazard_flood_imputed", "hazard_heavy_rain", "hazard_coastal", "hazard_tc"):
        print(f"    rows with {col.replace('hazard_', ''):<14}: {int(t[col].sum()):,}")
