def write_workbook(sheets, path):
    try:
        import xlsxwriter  # noqa: F401
        engine = "xlsxwriter"
    except ImportError:
        engine = "openpyxl"
    with pd.ExcelWriter(path, engine=engine) as xw:
        for name, df in sheets.items():
            df.to_excel(xw, sheet_name=name, index=False)
            if engine == "xlsxwriter":
                wb, ws = xw.book, xw.sheets[name]
                head = wb.add_format({"bold": True, "font_name": "Arial", "font_size": 10,
                                      "bg_color": "#DDE7F0", "border": 1, "text_wrap": True})
                body = wb.add_format({"font_name": "Arial", "font_size": 10})
                for j, c in enumerate(df.columns):
                    width = 60 if name in ("README", "Dictionary") and c in ("Description", "description") else \
                        min(max(len(str(c)) + 2, 10), 28)
                    ws.set_column(j, j, width, body)
                    ws.write(0, j, c, head)
                ws.freeze_panes(1, 2 if name not in ("README", "Dictionary") else 0)
                if name != "README" and len(df):
                    ws.autofilter(0, 0, len(df), len(df.columns) - 1)
        if engine == "openpyxl":
            from openpyxl.styles import Font, PatternFill
            for name, df in sheets.items():
                ws = xw.sheets[name]
                for cell in ws[1]:
                    cell.font = Font(name="Arial", bold=True, size=10)
                    cell.fill = PatternFill("solid", fgColor="DDE7F0")
                ws.freeze_panes = "C2" if name not in ("README", "Dictionary") else "A2"
    return engine


# ----------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project-dir", default=str(PROJECT_DIR))
    ap.add_argument("--no-daily", action="store_true", help="leave the two daily sheets out of the workbook")
    args = ap.parse_args()
    set_paths(Path(args.project_dir))

    ze, zu, zdaily, zdict, pdaily, pann, zb, st10, nfip, claims = load()
    z = zcta_events(ze, zu, claims)
    ce = county_events(z, zu, pdaily, pann, zb, claims)
    st = storms_table(z, st10, nfip)
    cd = county_daily(zdaily, zu, pdaily, zb)
    zu2 = zu.rename(columns={"main_parish_fips": "county_fips", "main_parish_name": "county_name"})
    cu = county_universe(pann, zu, ce)
    zd2 = zdaily.merge(zu[["zcta", "main_parish_fips"]].rename(columns={"main_parish_fips": "county_fips"}),
                       on="zcta", how="left")

    tables = {"ZCTA_events": z, "County_events": ce, "Storms": st, "ZCTA_daily": zd2,
              "County_daily": cd, "ZCTA_universe": zu2, "County_universe": cu}
    master = build_master(z, ce, claims)
    master.to_csv(OUT / f"MASTER_event_zcta_{STATE}_{YEAR}.csv", index=False)
    master.to_csv(CSV / f"MASTER_event_zcta_{STATE}_{YEAR}.csv", index=False)
    dic = pd.concat([master_dictionary(master), build_dictionary(tables, zdict)], ignore_index=True)
    readme = readme_sheet({"ze": len(z), "ce": len(ce), "st": len(st)})

    # CSVs (always complete)
    for name, df in tables.items():
        df.to_csv(CSV / f"{name}_{STATE}_{YEAR}.csv", index=False)
    dic.to_csv(CSV / f"Dictionary_{STATE}_{YEAR}.csv", index=False)

    sheets = {"README": readme, "MASTER": master, **{k: v for k, v in tables.items()
                                   if not (args.no_daily and k.endswith("_daily"))}, "Dictionary": dic}
    path = OUT / f"{STATE}_{YEAR}_flood_hazard_dataset.xlsx"
    engine = write_workbook(sheets, path)

    print(f"\nCOMPREHENSIVE FILE, {STATE} {YEAR}  ->  {path}  ({engine})")
    for k, v in tables.items():
        print(f"  {k:<16} {len(v):>9,} rows  {v.shape[1]:>3} columns")
    print(f"  Dictionary       {len(dic):>9,} variables "
          f"({int((dic.description == 'see README column guide').sum())} described only in the README)")
    print(f"  County_events: {ce.storm_id.nunique()} storms x {ce.county_fips.nunique()} counties; "
          f"median {ce.groupby('storm_id').county_fips.nunique().median():.0f} counties per storm")
    big = st.sort_values("n_zctas", ascending=False).head(5)
    print("  Largest storms:")
    print(big[["storm_id", "start_date", "end_date", "event_type", "n_zctas", "n_counties"]].to_string(index=False))
    print(f"  MASTER           {len(master):>9,} rows  {master.shape[1]:>3} columns  ->  "
          f"{OUT / f'MASTER_event_zcta_{STATE}_{YEAR}.csv'}")
    print(f"CSV copies in {CSV}")


if __name__ == "__main__":
    main()
