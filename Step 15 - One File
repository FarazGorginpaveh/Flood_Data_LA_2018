def build_master(z, ce, claims):
    m = z.copy()
    # county extent from County_events
    cx = ce[["storm_id", "county_fips", "share_zctas_affected", "share_area_affected_zcta"]].rename(
        columns={"share_zctas_affected": "c_share_zctas", "share_area_affected_zcta": "c_share_area"})
    m = m.merge(cx, on=["storm_id", "county_fips"], how="left")
    # observed depth at insured buildings (NFIP waterDepth, inches)
    m["nfip_depth_median_in"], m["nfip_depth_max_in"] = np.nan, np.nan
    if claims is not None and len(claims) and "water_depth_in" in claims:
        c = claims.dropna(subset=["zcta", "water_depth_in"]).copy()
        c["date"] = day(c.date)
        grp = {k: g for k, g in c.groupby("zcta")}
        med, mx = [], []
        for zc, s, e in zip(m.zcta, day(m.start_date), day(m.end_date)):
            g = grp.get(zc)
            w = g[(g.date >= s - pd.Timedelta(days=RAIN_LEAD_DAYS)) & (g.date <= e + pd.Timedelta(days=1))] \
                if g is not None else None
            med.append(w.water_depth_in.median() if w is not None and len(w) else np.nan)
            mx.append(w.water_depth_in.max() if w is not None and len(w) else np.nan)
        m["nfip_depth_median_in"], m["nfip_depth_max_in"] = med, mx
    out = pd.DataFrame(index=m.index)
    for col, src, *_ in MASTER_SPEC:
        if col == "zcta_boundary_year":
            out[col] = 2020
        elif col == "state":
            out[col] = STATE
        elif src is None:
            out[col] = np.nan
        else:
            out[col] = m[src] if src in m else np.nan
    return out.sort_values(["event_start_date", "event_id", "zcta"]).reset_index(drop=True)


def master_dictionary(master):
    return pd.DataFrame([{"sheet": "MASTER", "variable": c, "description": d, "unit": u, "type_or_format": "",
                          "missingness": mi, "pct_missing": round(100 * master[c].isna().mean(), 1)}
                         for c, _, d, u, mi in MASTER_SPEC])

