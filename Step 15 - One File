"""
STEP 15 - One comprehensive file: ZCTA AND county (parish) all-hazard dataset
=============================================================================
Collects everything built so far into ONE Excel workbook (plus the same tables as
CSV files) for Louisiana 2018:

  Sheet            Rows                         Content
  README           -                            what is in the file, conventions, sources
  MASTER           one per event x ZCTA         EVERYTHING REQUESTED IN ONE TABLE, columns in
                                                the order of the requirements (also saved as
                                                MASTER_event_zcta_LA_2018.csv)
  ZCTA_events      one per storm x ZCTA         all hazards, dates, unique storm ID, type,
                                                magnitude + source, return period, extent
                                                proxy, onset-to-peak, severity, rainfall,
                                                coastal, tropical cyclone, the storm's
                                                other ZCTAs and counties (+ counts)
  County_events    one per storm x county       the same, aggregated to the county, plus
                                                the parish-level streamflow flood measures,
                                                share of the county's ZCTAs affected, and
                                                the ZCTAs affected inside the county
  Storms           one per storm                dates, type, hazards, all ZCTAs and counties
                                                (+ counts), largest values, NWS episodes,
                                                NFIP claims (if step 11 was run)
  ZCTA_daily       every ZCTA x day             flood / rain / coastal / cyclone per day
  County_daily     every county x day           the same per county
  ZCTA_universe    every Louisiana ZCTA         what can be measured there
  County_universe  every Louisiana county       confidence, source, counts
  Dictionary       one per variable             description, unit, type, missingness

Conventions: ZCTA = 2020 Census boundaries; county = Louisiana parish (county FIPS);
local days (America/Chicago); blank cell = missing / not applicable (see Dictionary).

Inputs : data/final_zcta (step 14), data/final + data/evaluation (steps 6-7),
         data/zcta (steps 9-10), data/rain (12), data/coastal (13), data/nfip (11, optional)
Outputs: data/deliverable/LA_2018_flood_hazard_dataset.xlsx  and  data/deliverable/csv/
Usage  : python 15_comprehensive_file.py            (add --no-daily to leave out the
                                                     two large daily sheets)
"""

import argparse
from pathlib import Path

import geopandas as gpd
import numpy as np
import pandas as pd

# ----------------------------------------------------------------------------
# CONFIGURATION
# ----------------------------------------------------------------------------
PROJECT_DIR = Path(r"D:\Tufts\Wishlist\Sepideh_2")
YEAR = 2018
STATE = "LA"
RAIN_LEAD_DAYS = 1
FLOOD_ORDER = {"none": 0, "minor": 1, "moderate": 2, "major": 3}
INV_FLOOD = {v: k for k, v in FLOOD_ORDER.items()}
HAZARDS = ["streamflow", "flood_imputed", "heavy_rain", "coastal", "tc"]


def set_paths(project_dir):
    global D, OUT, CSV
    D = project_dir / "data"
    OUT = D / "deliverable"
    CSV = OUT / "csv"
    CSV.mkdir(parents=True, exist_ok=True)


def day(x):
    return pd.to_datetime(pd.Series(x).astype(str).str[:10], errors="coerce")


def join_unique(values):
    s = set()
    for v in values:
        if isinstance(v, str) and v:
            s |= set(v.split(";"))
    return ";".join(sorted(s - {""}))


def worst_coastal(values):
    v = [FLOOD_ORDER[c] for c in values if isinstance(c, str) and c in FLOOD_ORDER]
    return INV_FLOOD[max(v)] if v else np.nan


# ----------------------------------------------------------------------------
# 1. LOAD
# ----------------------------------------------------------------------------
def load():
    F = D / "final_zcta"
    ze = pd.read_csv(F / f"hazard_events_zcta_{STATE}_{YEAR}.csv",
                     dtype={"zcta": str, "main_parish_fips": str, "storm_parishes": str,
                            "storm_zctas": str})
    zu = pd.read_csv(F / f"zcta_universe_{STATE}_{YEAR}.csv", dtype={"zcta": str, "main_parish_fips": str})
    zdaily = pd.read_csv(F / f"zcta_daily_exposure_{STATE}_{YEAR}.csv", dtype={"zcta": str},
                         low_memory=False)
    zdict = pd.read_csv(F / f"data_dictionary_{STATE}_{YEAR}.csv")
    pdaily = pd.read_csv(D / "final" / "parish_daily_2018.csv",
                         dtype={"parish_fips": str, "flood_day": "boolean"})
    pann = pd.read_csv(D / "final" / "parish_annual_2018.csv", dtype={"parish_fips": str})
    zb = gpd.read_file(D / "zcta" / "zcta_boundaries_LA.gpkg")
    zb["zcta"] = zb.zcta.astype(str)
    zb["land_km2"] = zb.to_crs(5070).area / 1e6
    st10 = pd.read_csv(D / "zcta" / "storms_2018.csv")
    nfp = D / "nfip" / "storms_2018_with_claims.csv"
    nfip = pd.read_csv(nfp) if nfp.exists() else None
    cl = D / "nfip" / f"nfip_claims_{STATE}_{YEAR}_clean.csv"
    claims = pd.read_csv(cl, dtype={"zcta": str, "parish_fips": str}) if cl.exists() else None
    return ze, zu, zdaily, zdict, pdaily, pann, zb, st10, nfip, claims


# ----------------------------------------------------------------------------
# 2. ZCTA EVENTS (add county lists / counts, claims)
# ----------------------------------------------------------------------------
def zcta_events(ze, zu, claims):
    z = ze.copy()
    z = z.rename(columns={"main_parish_fips": "county_fips", "main_parish_name": "county_name",
                          "storm_parishes": "storm_counties", "storm_parish_names": "storm_county_names",
                          "storm_n_parishes": "storm_n_counties"})
    z["other_zctas_in_storm"] = [";".join(x for x in str(l).split(";") if x and x != zc)
                                 for zc, l in zip(z.zcta, z.storm_zctas.fillna(""))]
    z["n_other_zctas_in_storm"] = z.other_zctas_in_storm.map(lambda s: len(s.split(";")) if s else 0)

    # other FLOODED ZCTAs (stream flooding, own or imputed) - in the same event, and
    # in the same event with flood dates overlapping this ZCTA's dates
    z["_fl"] = (z.hazard_streamflow.fillna(0).astype(int) == 1) | (z.hazard_flood_imputed.fillna(0).astype(int) == 1)
    z["_s"], z["_e"] = day(z.start_date), day(z.end_date)
    ev_all, ev_n, same_all, same_n, cty_all, cty_n, cty_same = [], [], [], [], [], [], []
    for _, g in z.groupby("storm_id", sort=False):
        fl = g[g._fl]
        for zc, s0, e0 in zip(g.zcta, g._s, g._e):
            oth = fl[fl.zcta != zc]
            same = oth[(oth._s <= e0) & (oth._e >= s0)]
            ev_all.append(";".join(sorted(oth.zcta)))
            ev_n.append(len(oth))
            same_all.append(";".join(sorted(same.zcta)))
            same_n.append(len(same))
            cty_all.append(";".join(sorted(set(oth.county_fips.dropna()))))
            cty_n.append(len(set(oth.county_fips.dropna())))
            cty_same.append(";".join(sorted(set(same.county_fips.dropna()))))
    idx = [i for _, g in z.groupby("storm_id", sort=False) for i in g.index]
    z.loc[idx, "other_zctas_flooded_in_event"] = ev_all
    z.loc[idx, "n_other_zctas_flooded_in_event"] = ev_n
    z.loc[idx, "other_zctas_flooded_same_days"] = same_all
    z.loc[idx, "n_other_zctas_flooded_same_days"] = same_n
    z.loc[idx, "other_counties_flooded_in_event"] = cty_all
    z.loc[idx, "n_other_counties_flooded_in_event"] = cty_n
    z.loc[idx, "other_counties_flooded_same_days"] = cty_same
    for c in ("n_other_zctas_flooded_in_event", "n_other_zctas_flooded_same_days",
              "n_other_counties_flooded_in_event"):
        z[c] = z[c].astype(int)
    z = z.drop(columns=["_fl", "_s", "_e"])
    if claims is not None and len(claims):
        c = claims.dropna(subset=["zcta"]).copy()
        c["date"] = day(c.date)
        grp = {k: g for k, g in c.groupby("zcta")}
        n, paid = [], []
        for zc, s, e in zip(z.zcta, day(z.start_date), day(z.end_date)):
            g = grp.get(zc)
            if g is None:
                n.append(0); paid.append(0.0)
                continue
            m = g[(g.date >= s - pd.Timedelta(days=RAIN_LEAD_DAYS)) & (g.date <= e + pd.Timedelta(days=1))]
            n.append(len(m)); paid.append(round(m.paid.sum(), 2))
        z["nfip_claims"], z["nfip_paid_usd"] = n, paid
    lead = ["storm_id", "zcta", "county_fips", "county_name", "storm_origin", "event_type",
            "event_type_basis", "hazards"] + [f"hazard_{h}" for h in HAZARDS] + \
           ["start_date", "end_date", "peak_date", "length_days"]
    return z[[c for c in lead if c in z] + [c for c in z.columns if c not in lead]]


# ----------------------------------------------------------------------------
# 3. COUNTY EVENTS
# ----------------------------------------------------------------------------
def county_events(z, zu, pdaily, pann, zb, claims):
    pdaily = pdaily.copy()
    pdaily["date"] = day(pdaily.date)
    pd_idx = {k: g for k, g in pdaily.groupby("parish_fips")}
    n_zctas_county = zu.groupby("main_parish_fips").zcta.nunique()
    area = zb.set_index("zcta").land_km2
    conf = pann.set_index("parish_fips")[["confidence", "source"]] if "source" in pann else \
        pann.set_index("parish_fips")[["confidence"]]
    rows = []
    for (sid, cf), g in z.groupby(["storm_id", "county_fips"]):
        s, e = day(g.start_date).min(), day(g.end_date).max()
        w = area.reindex(g.zcta).fillna(0).to_numpy()
        wsum = w.sum() if w.sum() > 0 else 1.0
        rec = {
            "storm_id": sid, "county_fips": cf, "county_name": g.county_name.iloc[0],
            "storm_origin": g.storm_origin.iloc[0], "event_type": g.event_type.iloc[0],
            "event_type_basis": g.event_type_basis.iloc[0],
            "hazards": join_unique(g.hazards),
            **{f"hazard_{h}": int(g[f"hazard_{h}"].max()) for h in HAZARDS},
            "start_date": s.date(), "end_date": e.date(), "length_days": (e - s).days + 1,
            "n_zctas_affected": g.zcta.nunique(),
            "zctas_affected": ";".join(sorted(g.zcta)),
            "n_zctas_in_county": int(n_zctas_county.get(cf, 0)),
            "share_zctas_affected": round(g.zcta.nunique() / max(n_zctas_county.get(cf, 1), 1), 3),
            "share_area_affected_zcta": round(w.sum() / max(area[zu.zcta[zu.main_parish_fips == cf]].sum(), 1e-9), 3),
            "magnitude_max_zcta": g.magnitude_best.max(),
            "magnitude_source_of_max": (g.loc[g.magnitude_best.idxmax(), "magnitude_source"]
                                        if g.magnitude_best.notna().any() else "none"),
            "return_period_p90_max": g.return_period_p90.max(),
            "max_frac_reaches_max": g.max_frac_reaches.max(),
            "onset_to_peak_h_median": g.onset_to_peak_h.median(),
            "severity_max_norm": g.severity_max_norm.max(),
            "severity_composite_max": g.severity_composite.max() if "severity_composite" in g else np.nan,
            "rain_event_total_mm_areal": round(float((g.rain_event_total_mm.fillna(0) * w).sum() / wsum), 1)
            if "rain_event_total_mm" in g and g.rain_event_total_mm.notna().any() else np.nan,
            "rain_max_24h_mm_max": g.rain_max_24h_mm.max() if "rain_max_24h_mm" in g else np.nan,
            "rain_rp_24h_max": g.rain_rp_24h.max() if "rain_rp_24h" in g else np.nan,
            "rain_max_1h_cell_mm_max": g.rain_max_1h_cell_mm.max() if "rain_max_1h_cell_mm" in g else np.nan,
            "rain_rp_1h_cell_max": g.rain_rp_1h_cell.max() if "rain_rp_1h_cell" in g else np.nan,
            "coastal_flood_class_worst": worst_coastal(g.coastal_flood_class) if "coastal_flood_class" in g else np.nan,
            "coastal_wl_max_m_mhhw": g.coastal_wl_max_m_mhhw.max() if "coastal_wl_max_m_mhhw" in g else np.nan,
            "coastal_report": join_unique(g.coastal_report) if "coastal_report" in g else "",
            "tc_name": join_unique(g.tc_name.dropna().astype(str)) if "tc_name" in g else "",
            "tc_dist_km_min": g.tc_dist_km.min() if "tc_dist_km" in g else np.nan,
            "tc_wind_kt": g.tc_wind_kt.max() if "tc_wind_kt" in g else np.nan,
            "zcta_confidence_values": join_unique(g.confidence.astype(str)),
        }
        # parish-level streamflow measures in the same window (step 7 dataset)
        pg = pd_idx.get(cf)
        if pg is not None:
            win = pg[(pg.date >= s) & (pg.date <= e)]
            fd = win.flood_day.fillna(False).astype(bool)
            rec.update({
                "county_flood_days": int(fd.sum()) if win.source.ne("none").any() else np.nan,
                "county_flood_magnitude": win.loc[fd, "magnitude_peak_ratio"].max() if fd.any() else np.nan,
                "county_onset_to_peak_h": win.loc[fd, "duration_rise_h"].median() if fd.any() else np.nan,
                "county_severity_norm": win.loc[fd, "severity_norm"].max() if fd.any() else np.nan,
                "county_frac_reaches_max": win.nwm_frac_flooding.max() if "nwm_frac_flooding" in win else np.nan,
                "county_big_river_flood_days": int(win.big_river_flood_day.astype(bool).sum())
                if "big_river_flood_day" in win else 0,
                "county_flood_source": win.source.iloc[0] if len(win) else np.nan,
            })
        if cf in conf.index:
            rec["county_confidence"] = conf.loc[cf, "confidence"]
        if claims is not None and len(claims):
            c = claims[claims.parish_fips == cf]
            cd = day(c.date)
            m = c[(cd >= s - pd.Timedelta(days=RAIN_LEAD_DAYS)) & (cd <= e + pd.Timedelta(days=1))]
            rec["nfip_claims"], rec["nfip_paid_usd"] = len(m), round(m.paid.sum(), 2)
        rows.append(rec)
    ce = pd.DataFrame(rows)

    # storm-level lists (counties and ZCTAs) on every county row
    agg = z.groupby("storm_id").agg(
        storm_start_date=("start_date", "min"), storm_end_date=("end_date", "max"),
        storm_n_zctas=("zcta", "nunique"), storm_zctas=("zcta", lambda s: ";".join(sorted(set(s)))),
        storm_n_counties=("county_fips", "nunique"),
        storm_counties=("county_fips", lambda s: ";".join(sorted(set(s.dropna())))))
    names = z.drop_duplicates("county_fips").set_index("county_fips").county_name.to_dict()
    agg["storm_county_names"] = agg.storm_counties.map(
        lambda s: ";".join(str(names.get(c, c)) for c in s.split(";") if c))
    ce = ce.merge(agg.reset_index(), on="storm_id", how="left")
    ce["other_counties_in_storm"] = [";".join(x for x in l.split(";") if x and x != cf)
                                     for cf, l in zip(ce.county_fips, ce.storm_counties.fillna(""))]
    ce["n_other_counties_in_storm"] = ce.other_counties_in_storm.map(lambda s: len(s.split(";")) if s else 0)
    for c, n in {"magnitude_max_zcta": 3, "return_period_p90_max": 1, "max_frac_reaches_max": 3,
                 "onset_to_peak_h_median": 1, "severity_max_norm": 3, "county_flood_magnitude": 3,
                 "county_onset_to_peak_h": 1, "county_severity_norm": 3, "county_frac_reaches_max": 3}.items():
        if c in ce:
            ce[c] = pd.to_numeric(ce[c], errors="coerce").round(n)
    assert not ce.duplicated(["storm_id", "county_fips"]).any()
    return ce.sort_values(["storm_start_date", "storm_id", "county_fips"])


# ----------------------------------------------------------------------------
# 4. STORMS
# ----------------------------------------------------------------------------
def storms_table(z, st10, nfip):
    rows = []
    names = z.drop_duplicates("county_fips").set_index("county_fips").county_name.to_dict()
    old = st10.set_index("storm_id")
    for sid, g in z.groupby("storm_id"):
        cs = sorted(set(g.county_fips.dropna()))
        r = {"storm_id": sid, "storm_origin": g.storm_origin.iloc[0], "event_type": g.event_type.iloc[0],
             "event_type_basis": g.event_type_basis.iloc[0],
             "start_date": day(g.start_date).min().date(), "end_date": day(g.end_date).max().date(),
             "peak_day": g.storm_peak_day.iloc[0] if "storm_peak_day" in g else np.nan}
        r["length_days"] = (pd.Timestamp(r["end_date"]) - pd.Timestamp(r["start_date"])).days + 1
        r.update({f"n_zctas_{h}": int(g[f"hazard_{h}"].sum()) for h in HAZARDS})
        r.update({"n_zctas": g.zcta.nunique(), "zctas": ";".join(sorted(g.zcta)),
                  "n_counties": len(cs), "counties": ";".join(cs),
                  "county_names": ";".join(str(names.get(c, c)) for c in cs),
                  "tc_name": join_unique(g.tc_name.dropna().astype(str)) if "tc_name" in g else "",
                  "magnitude_max": g.magnitude_best.max(),
                  "return_period_p90_max": g.return_period_p90.max(),
                  "rain_max_24h_mm_max": g.rain_max_24h_mm.max() if "rain_max_24h_mm" in g else np.nan,
                  "rain_rp_24h_max": g.rain_rp_24h.max() if "rain_rp_24h" in g else np.nan,
                  "coastal_flood_class_worst": worst_coastal(g.coastal_flood_class)
                  if "coastal_flood_class" in g else np.nan,
                  "onset_to_peak_h_median": g.onset_to_peak_h.median(),
                  "severity_max_norm": g.severity_max_norm.max(),
                  "share_rows_observed": round((g.magnitude_source == "observed (USGS)").mean(), 3),
                  "share_rows_imputed": round((g.magnitude_source == "imputed (parish)").mean(), 3)})
        if sid in old.index:
            for c in ("nws_episode_ids", "nws_flood_cause", "n_areas_merged", "peak_span_days"):
                if c in old:
                    r[c] = old.loc[sid, c]
        rows.append(r)
    s = pd.DataFrame(rows)
    if nfip is not None and "nfip_claims" in nfip:
        s = s.merge(nfip[["storm_id", "nfip_claims", "nfip_paid_usd"]], on="storm_id", how="left")
    for c, n in {"magnitude_max": 3, "return_period_p90_max": 1, "onset_to_peak_h_median": 1,
                 "severity_max_norm": 3}.items():
        s[c] = pd.to_numeric(s[c], errors="coerce").round(n)
    return s.sort_values(["start_date", "storm_id"])


# ----------------------------------------------------------------------------
# 5. COUNTY DAILY AND UNIVERSES
# ----------------------------------------------------------------------------
def county_daily(zdaily, zu, pdaily, zb):
    zd = zdaily.merge(zu[["zcta", "main_parish_fips"]], on="zcta", how="left")
    zd = zd.merge(zb[["zcta", "land_km2"]], on="zcta", how="left")
    zd["w"] = zd.land_km2.fillna(0)
    g = zd.groupby(["main_parish_fips", "date"])
    out = pd.DataFrame({
        "n_zctas_heavy_rain": g.heavy_rain_day.sum(min_count=1) if "heavy_rain_day" in zd else np.nan,
        "n_zctas_coastal_flood": g.coastal_hazard_day.sum(min_count=1) if "coastal_hazard_day" in zd else np.nan,
        "n_zctas_tc_within_100km": g.tc_event_day.sum() if "tc_event_day" in zd else 0,
        "n_zctas_any_hazard": g.any_hazard_day.sum(),
    })
    if "rain_total_mm" in zd:
        zd["rw"] = zd.rain_total_mm * zd.w
        out["rain_total_mm_areal"] = (zd.groupby(["main_parish_fips", "date"]).rw.sum()
                                      / g.w.sum().replace(0, np.nan)).round(2)
        out["rain_max_1h_cell_mm"] = g.rain_max_1h_cell_mm_day.max()
    out = out.reset_index().rename(columns={"main_parish_fips": "county_fips"})
    p = pdaily.rename(columns={"parish_fips": "county_fips", "parish_name": "county_name"})
    keep = ["county_fips", "county_name", "date", "confidence", "source", "flood_day", "magnitude_peak_ratio",
            "duration_rise_h", "severity_norm", "nwm_frac_flooding", "big_river_flood_day",
            "usgs_gauges_flooding"]
    p = p[[c for c in keep if c in p]].rename(columns={
        "magnitude_peak_ratio": "flood_magnitude", "duration_rise_h": "onset_to_peak_h",
        "nwm_frac_flooding": "frac_reaches_flooding", "source": "flood_source"})
    p["date"] = day(p.date).dt.date.astype(str)
    out["date"] = day(out.date).dt.date.astype(str)
    cd = p.merge(out, on=["county_fips", "date"], how="left")
    cd["flood_day"] = cd.flood_day.astype("Int64")
    return cd


def county_universe(pann, zu, ce):
    u = pann.rename(columns={"parish_fips": "county_fips", "parish_name": "county_name"}).copy()
    keep = ["county_fips", "county_name", "confidence", "source", "frequency_events", "flood_days",
            "big_river_flood_days"]
    u = u[[c for c in keep if c in u]].rename(columns={"source": "flood_source",
                                                       "frequency_events": "streamflow_flood_events_parish",
                                                       "flood_days": "streamflow_flood_days_parish"})
    u["n_zctas"] = u.county_fips.map(zu.groupby("main_parish_fips").zcta.nunique()).fillna(0).astype(int)
    u["n_zctas_with_reaches"] = u.county_fips.map(
        zu[zu.streamflow_status == "ZCTA reaches"].groupby("main_parish_fips").zcta.nunique()).fillna(0).astype(int)
    u["n_storm_county_rows"] = u.county_fips.map(ce.groupby("county_fips").size()).fillna(0).astype(int)
    return u



# ----------------------------------------------------------------------------
# 5b. MASTER TABLE - one row per storm x ZCTA, columns ordered like the requirements
# ----------------------------------------------------------------------------
MASTER_SPEC = [
    # (master column, source column or callable, description, unit, missingness)
    ("event_id", "storm_id", "Unique storm/event ID; one weather system = one ID across all ZCTAs and counties", "-", "never missing"),
    ("zcta", "zcta", "ZIP Code Tabulation Area", "-", "never missing"),
    ("zcta_boundary_year", None, "Census year of the ZCTA boundaries", "year", "never missing"),
    ("county_fips", "county_fips", "County (Louisiana parish) FIPS holding most of the ZCTA's land", "-", "never missing"),
    ("county_name", "county_name", "County (parish) name", "-", "never missing"),
    ("state", None, "State", "-", "never missing"),
