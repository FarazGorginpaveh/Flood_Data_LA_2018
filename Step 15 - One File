def build_dictionary(tables, zdict):
    known = {r.variable: (r.description, r.unit, r.type_or_format, r.missingness)
             for r in zdict.itertuples() if not str(r.description).startswith("(see")}
    rows = []
    for tname, df in tables.items():
        for c in df.columns:
            base = c
            desc, unit, typ, miss = EXTRA.get(c) or known.get(c) or known.get(base) or \
                ("see README column guide", "-", str(df[c].dtype), "blank = not available")
            rows.append({"sheet": tname, "variable": c, "description": desc, "unit": unit,
                         "type_or_format": typ, "missingness": miss,
                         "pct_missing": round(100 * df[c].isna().mean(), 1)})
    return pd.DataFrame(rows)


